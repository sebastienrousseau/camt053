    given-names: Sebastien
    email: sebastian.rousseau@gmail.com
version: "0.0.23"
date-released: "2026-10-20"
license: "Apache-2.0 OR MIT"
repository-code: "https://github.com/sebastienrousseau/camt053"
url: "https://sebastienrousseau.github.io/camt053/"
keywords:
  - ISO 20022
  - camt.053
  - camt.052
  - camt.054
  - bank statements
  - reversing entries
  - treasury
